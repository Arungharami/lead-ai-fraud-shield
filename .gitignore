# Secrets — NEVER commit these
.env
.env.*
*.key
*.pem
credentials.json
secrets.yaml
config.local.yaml

# Model artifacts — large custom models excluded; pre-trained demo model is included
*.pkl
*.pt
*.h5
model/*.joblib.bak
# Allow the trained demo artifacts so users can clone and run immediately
!model/model.joblib
!model/metrics.json

# Data — do not commit real transaction data
data/*.csv
data/*.parquet
data/*.json
!data/sample_data.csv

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/
*.egg
venv/
.venv/
env/
.Python

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# macOS
.DS_Store
.AppleDouble

# IDEs
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
logs/

# Coverage
.coverage
htmlcov/
